                "flex-basis": "auto",
                "word-break": "break-word",
                "margin": "0 !important",
                "padding": "0"
              },
              ".navbar-toggler": {
                "-webkit-flex-basis": "auto",
                "flex-basis": "auto"
              },
              ".icons-menu": {
                "margin": "30px 0",
