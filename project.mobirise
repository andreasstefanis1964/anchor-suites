          "_name": "menu1",
          "_sourceTheme": "voyagem4",
          "_customHTML": "<section class=\"menu voyagem4_menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Position</header>\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\t\t<!--  -->\n\t\t<header>Menu</header>\n\t\t<input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"50\" max=\"150\" step=\"5\" value=\"125\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<input type=\"range\" title=\"Icons Amount\" name=\"iconsAmount\" min=\"0\" max=\"4\" step=\"1\" value=\"0\">\n\t\t<input type=\"checkbox\" title=\"Show Button(s)\" name=\"showButtons\" checked>\n\t\t<input type=\"color\" title=\"Hamburger Color\" name=\"hamburgerColor\" value=\"#cce4f0\">\n\t\t<select name=\"imageCount\" title=\"Image Count\">\n\t\t\t<option value=\"1\" selected>None</option>\n\t\t\t<option value=\"2\">1</option>\n\t\t\t<option value=\"3\">2</option>\n\t\t\t<option value=\"4\">3</option>\n\t\t\t<option value=\"5\">4</option>\n\t\t</select>\n\t\t<input type=\"image\" title=\"Image 1\" name=\"menuImage1\" value=\"@PROJECT_PATH@/assets/images/dsc_0629%20copy-2000x1333.jpg\" condition=\"imageCount > 1\">\n\t\t<input type=\"image\" title=\"Image 2\" name=\"menuImage2\" value=\"@PROJECT_PATH@/assets/images/dsc-791-2000x1333.jpg\" condition=\"imageCount > 2\">\n\t\t<input type=\"image\" title=\"Image 3\" name=\"menuImage3\" value=\"@PROJECT_PATH@/assets/images/dsc-776-2000x1333.jpg\" condition=\"imageCount > 3\">\n\t\t<input type=\"image\" title=\"Image 4\" name=\"menuImage4\" value=\"@PROJECT_PATH@/assets/images/lakkas-villas-areti-luxury-cottage-1-740x560.jpg\" condition=\"imageCount > 4\">\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Background\" name=\"menuBgColor\" value=\"#100a01\">\n\t\t<input type=\"color\" title=\"Border\" name=\"borderColor\" value=\"#eef5f4\">\n\t\t<input type=\"color\" title=\"Menu\" name=\"menuColor\" value=\"#eef5f4\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown navbar-expand-lg\" mbr-class=\"{'navbar-fixed-top':sticky}\">\n\t\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"index.html\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/fulllogo-anchor-suites.png-349x350.png\" alt mbr-style=\"{'height': logoSize + 'px'}\" title>\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption mbr-bold text-primary\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">VoyageM4</a></span>\n\t\t\t</div>\n\t\t\t<div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\"><li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-warning text-primary\" href=\"index.html#top\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">WELCOME TO OUR ANCHOR SUITES</a>\n\t\t\t\t\t</li><li class=\"nav-item\"><a class=\"nav-link link text-warning text-primary\" href=\"index.html#article01-26\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ABOUT US</a></li>\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t<li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-warning text-primary\" href=\"index.html#gallery1-c\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">GALLERY</a>\n\t\t\t\t\t</li><li class=\"nav-item\"><a class=\"nav-link link text-warning text-primary\" href=\"index.html#video1-2g\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">VIDEOS</a></li><li class=\"nav-item\"><a class=\"nav-link link text-warning text-primary\" href=\"index.html#slider2-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">AREA</a></li><li class=\"nav-item\"><a class=\"nav-link link text-warning text-primary\" href=\"https://ibe.channex.io/online-booking-anchor-suites?lang=en\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">BOOK ONLINE</a></li><li class=\"nav-item\"><a class=\"nav-link link text-warning text-primary\" href=\"index.html#forms01-2a\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CONTACT US</a></li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"iconsAmount > 0\">\n\t\t\t\t\t<a href=\"https://mobiri.se\" target=\"_blank\" class=\"icons__wrap\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://mobiri.se\" target=\"_blank\" class=\"icons__wrap\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-facebook-f fa\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://mobiri.se\" target=\"_blank\" class=\"icons__wrap\" mbr-if=\"iconsAmount > 2\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-twitter-square fa\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a href=\"https://mobiri.se\" target=\"_blank\" class=\"icons__wrap\" mbr-if=\"iconsAmount > 3\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont fa-instagram fa\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" class=\"mbr-section-btn\"><a class=\"btn btn-warning\" href=\"https://wa.me/30 697 815 4776\" data-app-placeholder=\"Type Text\">Get In Touch</a></div>\n\t\t</div>\n\t</nav>\n</section>",
