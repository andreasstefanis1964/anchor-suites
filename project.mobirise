        {
          "_name": "afeatures1",
          "_sourceTheme": "charitym5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".cards-row": {
              "row-gap": "50px"
            },
            ".card-wrapper": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "100%"
            },
            ".mbr-iconfont": {
              "font-size": "82px",
              "color": "@iconColor"
            },
            ".card-box": {
              "padding-left": "28px"
            },
            ".card-title": {
              "color": "#303030"
            },
            ".card-text": {
              "color": "#303030",
              "margin-top": "10px"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#46877e\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f6f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}} cards-row\">\n\n            <div class=\"card col-12 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-home mobi-mbri\" style=\"color: rgb(220, 193, 135); fill: rgb(220, 193, 135);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Your Entire vacation apartment with private entrance</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Each suite offers 35 sqm, access to a terrace with whirlpool, 1-bedrooms with flat-screen TV with streaming services, A/C, soundproof walls.</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont icon54-v4-wifi-1\" style=\"color: rgb(220, 193, 135); fill: rgb(220, 193, 135);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Free WiFi</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">We understand the importance of staying connected, even when you're on a relaxing vacation. That's why we're delighted to offer complimentary Wi-Fi throughout our suites with a speed of 25+ Mbps!</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mbri-map-pin\" style=\"color: rgb(220, 193, 135); fill: rgb(220, 193, 135);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Location</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Ideally located in the centre just 17 km from Thessaloniki Airport, Anchor Suites is only an 8-minute walk from Aristotelous Square and under 1 km from the Museum of the Macedonian Struggle.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-alert mobi-mbri\" style=\"color: rgb(220, 193, 135); fill: rgb(220, 193, 135);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Check-in/-out</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Check-in from 15:00 ✓ Check-out until 11:00<br>To make arrangements for check-in please contact the property at least 48 hours before arrival using the information on the booking confirmation.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont icon54-v4-jacuzzi\" style=\"color: rgb(220, 193, 135); fill: rgb(220, 193, 135);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Free Jacuzzi</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Indulge in relaxation with your very own private hot tub, and freshen up in the sleek walk-in shower with complimentary toiletries, towels, and a hairdryer.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 5\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont icon54-v4-cooker\" style=\"color: rgb(220, 193, 135); fill: rgb(220, 193, 135);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Full equipped Kitchen</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">The kitchenette includes aRefrigerator, Microwave, Coffee machine &amp; electric kettle, Toaster, Kitchenware &amp; dining table.<br>Everything you need for a convenient and comfortable stay.</p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_anchor": "afeatures1-28",
          "_isUserblock": true,
          "_cid": "u3jWqvXQ3U",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-section-title": {
              "margin-bottom": "25px",
              "color": "#dcc187"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "88px",
              "font-weight": "400",
              "color": "#2c3945"
            },
            ".image": {
              "position": "relative",
              "z-index": "0",
              "top": "-50px",
              "img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "-1",
                "width": "100%",
                "max-height": "410px",
                "object-fit": "cover"
              }
            },
            ".mbr-gallery-filter": {
              "text-align": "left",
              "padding": "0 20px",
              "border-bottom": "1px solid @borderColor",
              ".btn": {
                "padding": "0 20px 40px",
                "margin": "0",
                "margin-right": "35px",
                "color": "@tagsColor !important",
                "font-weight": "700",
                "text-align": "left",
                "background": "transparent !important",
                "position": "relative",
                "border": "none",
                "min-width": "auto"
              },
              "ul": {
                "display": "block",
                "li": {
                  "position": "relative",
                  "padding": "0"
                }
              },
              "li:not(.active) .btn.active:after, li.active .btn:not(.active):after, .mbr-gallery-filter .btn:hover:after": {
                "content": "\"\"",
                "position": "absolute",
                "left": "0",
                "right": "auto",
                "width": "100%",
                "bottom": "0",
                "height": "11px",
                "background-color": "@activeTabColor",
                "transition": "all 0.3s ease"
              }
            },
            ".mbr-gallery-row": {
              "margin-top": "50px"
            },
            ".mbr-slider .carousel-control": {
              "background": "#1b1b1b"
            },
            ".mbr-slider .carousel-control-prev": {
              "left": "0",
              "margin-left": "2.5rem",
              "border-radius": "4px"
            },
            ".mbr-slider .carousel-control-next": {
              "right": "0",
              "margin-right": "2.5rem",
              "border-radius": "4px"
            },
            ".mbr-slider .modal-body .close": {
              "background": "#1b1b1b"
            },
            ".mbr-gallery-item > div::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%",
              "background": "@overlayColor",
              "opacity": "0",
              "transition": "0.2s opacity ease-in-out",
              "& when (@gradOverlay)": {
                "background": "linear-gradient(to left, @overlayColor, @overlayColor2) !important"
              }
            },
            ".mbr-gallery-item > div:hover::before": {
              "opacity": "@overlayOpacity !important"
            },
            ".mbr-gallery-title": {
              "transition": "all .3s",
              "position": "absolute",
              "display": "block",
              "font-weight": "700",
              "width": "100%",
              "bottom": "30px",
              "left": "0",
              "text-align": "center",
              "padding": "0 1rem",
              "color": "#fff",
              "background": "transparent"
            },
            "& when (@showIcon)": {
              ".icon-focus": {
                "transition": "all .3s",
                "top": "30%",
                "width": "48px",
                "height": "48px",
                "transform": "translateY(-30%)"
              }
            },
            "& when not (@showIcon)": {
              ".icon-focus": {
                "display": "none"
              }
            },
            ".mbr-gallery-item": {
              "> div img, div:before": {
                "border-radius": "4px",
                "height": "255px"
              },
              "> div": {
                "transition": "all .3s",
                "border-radius": "4px"
              },
              "&:hover": {
                "> div": {
                  "transform": "scale(0.95)"
                }
              }
            },
            ".carousel-control-prev": {
              ".mbri-left:before": {
                "content": "\"\\e90a\""
              }
            },
            ".carousel-control-next": {
              ".mbri-right:before": {
                "content": "\"\\e909\""
              }
            },
            ".modal-body a.close": {
              "border-radius": "0",
              "font-size": "32px",
              "top": "0",
              "right": "0",
              "height": "70px",
              "width": "70px",
              "line-height": "70px"
            },
            "@media (max-width: 991px)": {
              ".mbr-section-subtitle": {
                "margin-bottom": "20px",
                "text-align": "center"
              },
              ".mbr-section-title": {
                "text-align": "center"
              },
              ".image": {
                "top": "auto",
                "height": "420px"
              },
              ".mbr-gallery-filter": {
                ".btn": {
                  "padding": "0 0 22px"
                },
                "ul li": {
                  "margin-bottom": "10px"
                }
              },
              ".mbr-gallery-item": {
                "> div img, div:before": {
                  "height": "auto",
                  "border-radius": "3px"
                },
                "> div": {
                  "border-radius": "3px"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".image": {
                "height": "290px"
              }
            }
          },
          "_name": "gallery1",
          "_customHTML": "<section class=\"mbr-gallery mbr-slider-carousel extGallery gallery1\" group=\"Sliders & Galleries\" plugins=\"Masonry,Slider,BootstrapCarouselSwipe,Gallery,VimeoVideo\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" inline>\n        <input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Image\" name=\"showImage\" checked>\n        <header>Filter</header>\n        <input type=\"color\" title=\"Tags Color\" name=\"tagsColor\" value=\"#3a6686\">\n        <input type=\"color\" title=\"Active Tab Color\" name=\"activeTabColor\" value=\"#c0e8e2\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#cce4f0\">\n        <header>Gallery</header>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#003d59\">\n        <input type=\"checkbox\" title=\"Gradient Overlay\" name=\"gradOverlay\">\n        <input type=\"color\" title=\"Overlay Color 2\" name=\"overlayColor2\" value=\"#ffffff\" condition=\"gradOverlay\">\n        <input type=\"range\" title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" inline>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n        <input type=\"checkbox\" title=\"Show Icon\" name=\"showIcon\" checked>\n        <input type=\"gallery\" title=\"Gallery\" name=\"gallery\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    \n    <div class=\"container\" mbr-if=\"showTitle || showSubtitle || showImage\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-class=\"{'col-lg-5' : showImage, 'col-lg-12' : !showImage}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">GALLERY</h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">Step into a stylish retreat at Anchor Suites, where comfort meets sophistication in this beautifully designed 35 m² one-bedroom apartment. Perfect for couples, families, or solo travelers, the space features a spacious living room, private balcony with stunning sea views, and a thoughtfully equipped kitchenette for all your cooking needs.&nbsp;</h4>\n            </div>\n            <div class=\"col-lg-7 col-12\" mbr-if=\"showImage\">\n                <div class=\"image\">\n                    <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2025-06-23-at-19.55.06.webp-1-1600x900.webp\" alt title>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"gallery__wrap container\">\n        <div mbr-gallery=\"gallery\" mbr-gallery-spacing=\"2\" mbr-gallery-show-filter mbr-gallery-show-bullets></div>\n    </div>\n</section>",
